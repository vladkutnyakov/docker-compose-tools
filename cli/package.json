    "prepublishOnly": "npm run typecheck && npm run test",
    "prepare": "npm run build"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/react": "^19.3.2",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
