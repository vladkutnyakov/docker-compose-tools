{
  "name": "docker-compose-tools",
  "displayName": "Docker Compose Tools",
  "description": "",
  "version": "0.0.1",
  "author": {
    "name": "Vlad Kutnyakov",
    "email": "kutnyakov1@yandex.ru",
    "url": "https://github.com/vladkutnyakov"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "docker-compose-tools",
          "title": "Compose Tools",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "docker-compose-tools": [
        {
          "id": "dockerComposeFiles",
          "name": "Files"
        }
      ]
    },
    "commands": [
      {
        "command": "docker-compose-tools.file.open",
        "title": "Open File"
      },
      {
        "command": "docker-compose-tools.file.openFolderInEditor",
        "title": "Open Folder in Editor"
      },
      {
        "command": "docker-compose-tools.file.openFolderInFileExplorer",
        "title": "Open Folder in File Explorer"
      },
      {
        "command": "docker-compose-tools.file.add",
        "title": "Add File",
        "icon": "$(add)"
      },
      {
        "command": "docker-compose-tools.file.remove",
        "title": "Remove File"
      },
      {
        "command": "docker-compose-tools.compose.pull",
        "title": "Compose Pull"
      },
      {
        "command": "docker-compose-tools.compose.up",
        "title": "Compose Up"
      },
      {
        "command": "docker-compose-tools.compose.down",
        "title": "Compose Down"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "docker-compose-tools.file.add",
          "group": "navigation",
          "when": "view == dockerComposeFiles"
        }
      ],
      "view/item/context": [
        {
          "command": "docker-compose-tools.compose.pull",
          "when": "view == dockerComposeFiles",
          "group": "compose@1"
        },
        {
          "command": "docker-compose-tools.compose.up",
          "when": "view == dockerComposeFiles",
          "group": "compose@2"
        },
        {
          "command": "docker-compose-tools.compose.down",
          "when": "view == dockerComposeFiles",
          "group": "compose@3"
        },
        {
          "command": "docker-compose-tools.file.open",
          "when": "view == dockerComposeFiles",
          "group": "file@1"
        },
        {
          "command": "docker-compose-tools.file.openFolderInEditor",
          "when": "view == dockerComposeFiles",
          "group": "file@2"
        },
        {
          "command": "docker-compose-tools.file.openFolderInFileExplorer",
          "when": "view == dockerComposeFiles",
          "group": "file@3"
        },
        {
          "command": "docker-compose-tools.file.remove",
          "when": "view == dockerComposeFiles",
          "group": "file@4"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.92.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
